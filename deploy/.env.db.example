# Copy to /opt/leaderboard/.env.db on the server and chmod 600. Never commit the real file.
# Generate each password with: openssl rand -base64 32 | tr -d '/+='
# db-init/01-roles.sh reads them only on the very first start, with an empty data volume.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
LEADERBOARD_OWNER_PASSWORD=
LEADERBOARD_APP_PASSWORD=
