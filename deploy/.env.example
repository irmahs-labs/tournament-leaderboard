# Copy to /opt/leaderboard/.env on the server and chmod 600. Never commit the real file.

# The app image to run: a release version such as 1.0.0.
APP_TAG=

# The app connects as leaderboard_app; Flyway migrates as leaderboard_owner.
# The passwords are the ones in .env.db.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/leaderboard
SPRING_DATASOURCE_USERNAME=leaderboard_app
SPRING_DATASOURCE_PASSWORD=
SPRING_FLYWAY_USER=leaderboard_owner
SPRING_FLYWAY_PASSWORD=

# The "prod" OAuth client from Google Cloud (used once sign-in exists).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
